from types import SimpleNamespace

import torch
import torch.nn as nn

from src.models.stip_ossm_box import STIP
from src.util.misc import NestedTensor


class _DummyBackbone(nn.Module):
    def forward(self, samples):
        batch = samples.tensors.shape[0]
        device = samples.tensors.device
        memory_mask = torch.zeros((batch, 2, 2), dtype=torch.bool, device=device)
        last_mask = torch.zeros((batch, 1, 1), dtype=torch.bool, device=device)
        memory = NestedTensor(torch.randn(batch, 1024, 2, 2, device=device), memory_mask)
        last = NestedTensor(torch.randn(batch, 2048, 1, 1, device=device), last_mask)
        pos = [
            torch.zeros(batch, 256, 2, 2, device=device),
            torch.zeros(batch, 256, 1, 1, device=device),
        ]
        return [memory, last], pos


class _DummyDETRTransformer(nn.Module):
    def __init__(self, num_queries=4):
        super().__init__()
        self.num_queries = num_queries

    def forward(self, src, mask, query, pos):
        batch = src.shape[0]
        hs = src.new_zeros((2, batch, self.num_queries, 256))
        # Make instance representations distinct and deterministic.
        values = torch.arange(self.num_queries, device=src.device, dtype=src.dtype)
        hs[..., 0] = values
        encoder = src.new_zeros((batch, 256, 2, 2))
        return hs, encoder


class _DummyBoxes(nn.Module):
    def forward(self, hs):
        batch_shape = hs.shape[:-1]
        logits = hs.new_zeros((*batch_shape, 4))
        centers = hs.new_tensor(
            [[-0.5, -0.5, -1.0, -1.0], [0.5, 0.5, -1.0, -1.0], [0.0, 0.0, -1.4, -1.4], [0.4, -0.4, -1.5, -1.2]]
        )
        logits[:] = centers
        return logits


class _DummyDETR(nn.Module):
    def __init__(self):
        super().__init__()
        self.backbone = _DummyBackbone()
        self.input_proj = nn.Conv2d(2048, 256, 1)
        self.query_embed = nn.Embedding(4, 256)
        self.transformer = _DummyDETRTransformer(4)
        self.class_embed = nn.Linear(256, 92)
        nn.init.zeros_(self.class_embed.weight)
        nn.init.zeros_(self.class_embed.bias)
        self.class_embed.bias.data[1] = 5.0  # every node is a confident human
        self.bbox_embed = _DummyBoxes()


class _DummyBLIP(nn.Module):
    def __init__(self):
        super().__init__()
        self.calls = []
        self.proj = nn.Linear(3, 256, bias=False)
        nn.init.constant_(self.proj.weight, 0.01)

    def forward(self, image, _caption, mode):
        self.calls.append(mode)
        if mode == "multilscale":
            pooled = image.mean(dim=(-1, -2))
            token = self.proj(pooled).unsqueeze(1)
            return [token.repeat(1, 5, 1) + offset for offset in (0.0, 0.1, 0.2)]
        raise AssertionError(mode)


class _RecordingMoE(nn.Module):
    def __init__(self):
        super().__init__()
        self.aux_values = []

    def forward(
        self,
        rel_reps,
        visual_global,
        visual_instance,
        visual_action,
        text_features,
    ):
        # Preserve a gradient path through every semantic input.
        semantic = (
            visual_global + visual_instance + visual_action
        ).mean(dim=-1, keepdim=True)
        output = rel_reps + semantic
        aux = visual_global.mean()
        self.aux_values.append(aux.detach())
        return output, aux


def _args(text_library, hard_mining=True):
    return SimpleNamespace(
        hidden_dim=256,
        num_classes=91,
        num_actions=117,
        train_detr=False,
        relation_feature_map_from="backbone",
        use_spatial_feature=False,
        use_tail_semantic_feature=False,
        use_union_feature=False,
        ossm_obj_act_prior="obj_act_prior.npy",
        no_interaction_decoder=True,
        hoi_aux_loss=False,
        hoi_nheads=8,
        hoi_dec_layers=2,
        use_relation_dependency_encoding=True,
        use_query_fourier_encoding=False,
        ossm_text_library=text_library,
        use_moe_visual_router=True,
        use_moe_aux_loss=True,
        use_moe_noisy_gating=False,
        ossm_region_image_size=32,
        ossm_debug_regions=True,
        apply_nms_on_detr=False,
        dataset_file="hico-det",
        adaptive_relation_query_num=False,
        num_hoi_queries=3,
        use_hard_mining_for_relation_discovery=hard_mining,
        use_relation_tgt_mask=False,
        use_relation_tgt_mask_attend_topk=2,
        aux_loss=False,
    )


def _matcher(outputs, targets):
    return [
        (
            torch.tensor([0, 1], device=outputs["pred_boxes"].device),
            torch.tensor([0, 1], device=outputs["pred_boxes"].device),
        )
        for _ in targets
    ]


def _batch(batch_size=2):
    height, width = 8, 12
    rgb = torch.stack(
        [torch.full((3, height, width), 0.2 + 0.2 * i) for i in range(batch_size)]
    )
    mean = rgb.new_tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1)
    std = rgb.new_tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1)
    samples = NestedTensor((rgb - mean) / std, torch.zeros(batch_size, height, width, dtype=torch.bool))
    targets = []
    for _ in range(batch_size):
        relation_map = torch.zeros(2, 2, 117)
        relation_map[0, 1, 10] = 1
        targets.append(
            {
                "orig_size": torch.tensor([height, width]),
                "labels": torch.tensor([1, 2]),
                "boxes": torch.tensor([[0.3, 0.3, 0.2, 0.2], [0.7, 0.7, 0.2, 0.2]]),
                "relation_map": relation_map,
            }
        )
    return samples, list(rgb), targets


def test_train_forward_contract_gradients_and_batch_moe_aggregation():
    text_library = "/wzj/zijian/SAM-BLIP-HOI-FUSE/SAM-BLIP-HOI3/hico_L_embeds_256.npy"
    model = STIP(_args(text_library), _DummyDETR(), _DummyBLIP(), _matcher)
    recorder = _RecordingMoE()
    model.moe_fusion_module = recorder
    model.train()
    samples, images, targets = _batch(2)
    output = model(samples, images, targets)

    assert len(output["pred_rel_pairs"]) == 2
    assert all(value.shape == (3, 117) for value in output["pred_actions"])
    assert all(value.shape == (3, 117) for value in output["pred_sampled_actions"])
    assert all(value.shape == (3,) for value in output["pred_action_exists"])
    assert len(recorder.aux_values) == 2
    assert torch.allclose(output["moe_aux_loss"], torch.stack(recorder.aux_values).mean())
    assert torch.allclose(output["moe_loss_weighted"], 0.05 * output["moe_aux_loss"])
    assert all(row["sam_runtime"] is False for row in output["ossm_box_debug"])
    assert model.blip.calls == ["multilscale"] * 4

    loss = sum(value.sum() for value in output["pred_actions"])
    loss.backward()
    assert model.action_embed.weight.grad is not None
    assert model.rel_query_pre_proj.weight.grad is not None
    assert model.instance_roi_pooler[1].weight.grad is not None
    assert model.instance_pair_fusion[1].weight.grad is not None
    assert model.action_roi_pooler[1].weight.grad is not None
    assert all(parameter.grad is None for parameter in model.blip.parameters())
    assert all(parameter.grad is None for parameter in model.detr.parameters())


def test_random_sampling_and_eval_paths_both_execute_box_fusion():
    text_library = "/wzj/zijian/SAM-BLIP-HOI-FUSE/SAM-BLIP-HOI3/hico_L_embeds_256.npy"
    samples, images, targets = _batch(1)
    for hard_mining, training in ((False, True), (True, False)):
        model = STIP(_args(text_library, hard_mining), _DummyDETR(), _DummyBLIP(), _matcher)
        recorder = _RecordingMoE()
        model.moe_fusion_module = recorder
        model.train(training)
        output = model(samples, images, targets)
        assert len(recorder.aux_values) == 1
        assert output["pred_rel_pairs"][0].shape == (3, 2)
        assert model.last_box_regions is not None
        assert model.last_box_regions["human_boxes_xyxy"].shape == (3, 4)
        assert model.last_box_regions["object_boxes_xyxy"].shape == (3, 4)
        assert model.last_box_regions["union_boxes_xyxy"].shape == (3, 4)
        assert model.last_box_regions["instance_layer"] == -2
        assert model.last_box_regions["action_layer"] == -1

def test_full_interaction_decoder_forward_and_backward():
    text_library = "/wzj/zijian/SAM-BLIP-HOI-FUSE/SAM-BLIP-HOI3/hico_L_embeds_256.npy"
    args = _args(text_library)
    args.no_interaction_decoder = False
    model = STIP(args, _DummyDETR(), _DummyBLIP(), _matcher)
    model.eval()
    samples, images, targets = _batch(1)
    output = model(samples, images, targets)
    assert output["pred_actions"][0].shape == (3, 117)
    output["pred_actions"][0].sum().backward()
    assert model.action_embed.weight.grad is not None
    assert model.blip_scene_pos_embed.weight.grad is not None
